# Copia este archivo a .env en la raíz del proyecto
# cp .env.example .env

# --- Caché de biblioteca (metadatos escaneados; acelera reinicios) ---
# En Docker se usa el volumen onyx-cache en /cache
CACHE_DIR=./data/cache

# --- Música ---
# Ruta en el host (relativa o absoluta). En OMV usa ruta absoluta del NAS.
MUSIC_PATH=./music

# --- Puertos ---
FRONTEND_PORT=4000
PORT=9090

# --- Autenticación (cámbialo en producción) ---
ONYX_USER=admin
ONYX_PASSWORD=onyx123
JWT_SECRET=genera-un-secreto-largo-y-aleatorio

# --- Frontend (Docker) ---
# Déjalo vacío para usar proxy /api (recomendado). Solo para desarrollo directo al API:
# REACT_APP_API_URL=http://localhost:9090
REACT_APP_API_URL=
