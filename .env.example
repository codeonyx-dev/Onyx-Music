# ═══════════════════════════════════════════════════════════════════
#  ONYX MUSIC — configuración única (copia a .env en esta carpeta)
#  cp .env.example .env
# ═══════════════════════════════════════════════════════════════════

# ── Música ─────────────────────────────────────────────────────────
# Ruta en tu PC o NAS. En Docker se monta como /music (solo lectura).
# OMV/NAS: usa ruta absoluta, ej. /srv/dev-disk-by-label-xxx/Musica
MUSIC_PATH=./music

# ── Puertos ────────────────────────────────────────────────────────
FRONTEND_PORT=4000
PORT=9090

# ── Login (cámbialo antes de exponer en internet) ────────────────
ONYX_USER=admin
ONYX_PASSWORD=cambia-esta-contraseña
JWT_SECRET=genera-un-secreto-largo-y-aleatorio

# ── Reproducción ───────────────────────────────────────────────────
# Guardar en el navegador las canciones que ya escuchaste (repite al instante).
# Precargar la siguiente en segundo plano (true recomendado en red local/NAS)
PREFETCH_NEXT=true
# Crossfade al terminar una canción (false = cambio instantáneo)
CROSSFADE_DEFAULT=false
# Caché del navegador para streams en segundos
STREAM_CACHE_MAX_AGE=3600

# ── Caché de metadatos (escaneo de biblioteca) ─────────────────────
# En Docker se usa el volumen onyx-cache automáticamente.
# Solo para desarrollo local sin Docker:
# CACHE_DIR=./data/cache

# ── Frontend (Docker) ──────────────────────────────────────────────
# Déjalo vacío: nginx hace proxy de /api al backend (recomendado).
REACT_APP_API_URL=

# ── Modo Docker ────────────────────────────────────────────────────
# split  = frontend + backend (por defecto)
# single = un solo contenedor (recomendado en NAS / OpenMediaVault)
COMPOSE_PROFILES=split
