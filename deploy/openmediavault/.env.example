# Copia a .env en esta misma carpeta:
# cp .env.example .env

# Ruta ABSOLUTA en el NAS a tu biblioteca de música (obligatorio en OMV)
# Ejemplo: /srv/dev-disk-by-uuid-XXXX/music
MUSIC_PATH=/ruta/absoluta/a/tu/musica

FRONTEND_PORT=4000
PORT=9090

ONYX_USER=admin
ONYX_PASSWORD=cambia-esta-contraseña
JWT_SECRET=genera-un-secreto-largo-y-aleatorio

# Vacío = la app usa proxy /api (recomendado en Docker)
REACT_APP_API_URL=
